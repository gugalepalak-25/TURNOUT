# ==========================================
# TURNOUT — GOVERNANCE CONTROL ROOM ENV CONFIG
# ==========================================

# Server & Network Configuration
PORT=8787
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
# For local Docker: postgresql://turnout:turnout_secret@localhost:5432/turnout_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/turnout_governance?schema=public

# NEAR Protocol Configuration
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.near.org

# House of Stake Smart Contracts
# Testnet deployments:
HOUSE_OF_STAKE_VOTING_CONTRACT=vote.hos.testnet
HOUSE_OF_STAKE_VENEAR_CONTRACT=venear.hos.testnet

# Turnout Smart Contracts (Testnet Registry)
TURNOUT_SCORECARD_CONTRACT=turnout-registry.testnet
TURNOUT_REWARD_CONTRACT=turnout-rewards.testnet

# Oracle Publisher Account (Used to sign published scorecards on-chain)
ORACLE_ACCOUNT_ID=turnout-oracle.testnet
ORACLE_PRIVATE_KEY=

# Governance Forum (Discourse Public API)
DISCOURSE_BASE_URL=https://gov.near.org

# AI Governance Analyst Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

